# Copy this file to C:\Thuraya\.env on the Windows Server.
# Never commit the real file. Fill every placeholder locally on the server.

# Next.js sets NODE_ENV=production for `next start` / standalone. Do not set NODE_ENV here.

APP_ENV=production
SITE_URL=https://thuraya-alshamsi.gate-digital.com
LISTEN_HOST=127.0.0.1
PORT=3000

# Dedicated application role — not the postgres superuser.
# Example after you create the role and database:
#   postgresql://thuraya_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/thuraya
DATABASE_URL=postgresql://thuraya_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/thuraya
DATABASE_SSL=false
DB_POOL_MAX=10

# Permanent storage outside every release. Do not point this inside releases\ or current\.
STORAGE_DIR=C:\Thuraya\storage

# Used only when no active admin exists. Change immediately after first login.
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_NAME=مدير المحتوى

# Production public forms require Cloudflare Turnstile.
CAPTCHA_MODE=required
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# Optional English translation on publish
AUTO_TRANSLATE_ON_PUBLISH=false
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# Optional backup/restore helpers
BACKUP_ROOT=C:\Thuraya\backups
