<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
    <!-- 30 MB to cover CMS multipart overhead above the 25 MB application limit. -->
    <httpRuntime maxRequestLength="30720" executionTimeout="180" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="source_package_v1.0" />
          <add segment="node_modules" />
          <add segment="scripts" />
          <add segment="db" />
          <add segment="backups" />
          <add segment="storage" />
          <add segment="releases" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".dump" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".mjs" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Block sensitive paths" stopProcessing="true">
          <match url="^(\.env|package-lock\.json|package\.json|tsconfig\.json|next\.config\.|Dockerfile|docker-compose|README|AGENTS\.md|START_HERE\.md)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Reverse proxy to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{CACHE_URL}" pattern="^(.+)://" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PORT" value="443" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
</system.webServer>
</configuration>
