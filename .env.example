# Runtime environment
# Do not set NODE_ENV here. Next.js sets development for `next dev` and production for `next build` / `next start`.
APP_ENV=development
SITE_URL=http://localhost:3000
POSTGRES_PASSWORD=change-local-db-password
DATABASE_URL=postgresql://thuraya:change-local-db-password@localhost:5432/thuraya
DATABASE_SSL=false
STORAGE_DIR=./storage
DB_POOL_MAX=10

# Initial admin - used only if no active admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-2026!
ADMIN_NAME=مدير المحتوى

# Public forms / Cloudflare Turnstile
CAPTCHA_MODE=optional
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional automatic English translation on publish
AUTO_TRANSLATE_ON_PUBLISH=false
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=
